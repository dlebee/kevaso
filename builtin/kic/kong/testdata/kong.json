  "routes": [
    {
      "name": "acme.tok-123_abc",
      "paths": [
        "/.well-known/acme-challenge/tok-123_abc"
      ],
      "protocols": [
        "http"
      ],
      "strip_path": false,
      "preserve_host": false,
      "plugins": [
        {
          "name": "request-termination",
          "config": {
            "body": "tok-123_abc.thumbprint-XYZ",
            "content_type": "text/plain",
            "status_code": 200
          }
        }
      ]
    }
  ],
  "certificates": [
    {
      "cert": "-----BEGIN CERTIFICATE-----\nMIIBc2FtcGxl\n-----END CERTIFICATE-----\n",
      "key": "-----BEGIN EC PRIVATE KEY-----\nMHcCc2FtcGxl\n-----END EC PRIVATE KEY-----\n",
      "snis": [
        {
